# Copiar para .env (o .env nunca é publicado). Valores de desenvolvimento, falsos.

# Base de dados (infra/compose.yml)
DATABASE_URL="postgresql://miaum:miaum@localhost:5432/miaum"

# URL pública da app
APP_URL="http://localhost:3000"

# Auth.js — gerar com: npx auth secret
AUTH_SECRET="troca-isto-por-um-segredo-aleatorio"
AUTH_TRUST_HOST=true

# Domínios de email permitidos no login (separados por vírgula). NÃO usar domínios reais aqui.
ALLOWED_EMAIL_DOMAINS="example.test"

# Primeiro administrador (recebe o perfil ADMIN no primeiro login)
BOOTSTRAP_ADMIN_EMAIL="admin@example.test"

# Login rápido de desenvolvimento (só funciona com NODE_ENV=development)
DEV_LOGIN=true

# OIDC genérico (opcional; ex.: SSO da UMinho). Deixar vazio para desativar.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_NAME="SSO"

# Email (Mailpit em desenvolvimento: UI em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="miaUM <no-reply@example.test>"

# Tarefas periódicas (/api/cron/*)
CRON_SECRET="troca-isto-tambem"

# Ficheiros carregados
UPLOADS_DIR="./uploads"

# Limites (valores por omissão da especificação)
REPORT_TTL_DAYS=30
REMINDER_DAY=25
CLAIM_REVERT_DAYS=5
CLAIMS_MAX_ACTIVE=1
CLAIMS_MAX_PER_WINDOW=3
CLAIMS_WINDOW_DAYS=7
REPORTS_MAX_PER_DAY=10
CHAT_MAX_PER_MINUTE=20
MAGIC_LINKS_MAX_PER_HOUR=5
FLAGS_TO_HIDE=3
MATCH_THRESHOLD=0.5
MATCH_TOLERANCE_BEFORE_HOURS=2
MATCH_TOLERANCE_AFTER_DAYS=7
