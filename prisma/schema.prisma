// miaUM — schema Prisma (PROPOSTA para aprovação, Fase 1)
// Datas sempre em UTC; regras de negócio em Europe/Lisbon (src/domain).

generator client {
  provider = "prisma-client-js"
}

// A URL da BD está em prisma.config.ts (Prisma 7); a app liga-se via @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  STAFF
  ADMIN
}

enum ReportType {
  LOST
  FOUND
}

/// LOST: OPEN | RECOVERED.  FOUND: PUBLISHED | CLAIMED | RETURNED.
/// A compatibilidade tipo/estado é validada em src/domain/report-state.ts.
enum ReportStatus {
  OPEN
  RECOVERED
  PUBLISHED
  CLAIMED
  RETURNED
}

enum HolderType {
  /// Entregue (ou a entregar) num ponto de entrega, indicado em texto livre
  POINT
  /// Fica com quem encontrou; o contacto é revelado a quem reclamar
  FINDER
}

enum Color {
  BLACK
  WHITE
  GREY
  BLUE
  RED
  GREEN
  YELLOW
  ORANGE
  PINK
  PURPLE
  BROWN
  BEIGE
  SILVER
  GOLD
  MULTICOLOR
  OTHER
}

enum ClaimStatus {
  ACTIVE
  COMPLETED
  REJECTED
  EXPIRED
}

enum SuggestionStatus {
  SUGGESTED
  REJECTED
}

enum LocationStatus {
  CONFIRMED
  PROVISIONAL
}

enum FlagTarget {
  REPORT
  CONVERSATION
}

enum FlagReason {
  SPAM
  INAPPROPRIATE
  PERSONAL_DATA
  OTHER
}

enum NotificationType {
  NEW_MATCH
  ITEM_CLAIMED
  ITEM_MOVED_TO_POINT
  NEW_MESSAGE
  REPORT_REVERTED
  EXPIRY_REMINDER
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Utilizadores e autenticação (tabelas exigidas pelo adaptador Prisma do Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  /// null depois de a conta ser apagada (anonimização)
  email         String?   @unique
  emailVerified DateTime?
  /// Apenas o primeiro nome (minimização RGPD). Chama-se `name` por compatibilidade com o Auth.js.
  name          String?
  locale        String    @default("pt")
  notifyEmail   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  accounts         Account[]
  sessions         Session[]
  roles            UserRole[]
  staffAssignments StaffAssignment[]
  reports          Report[]          @relation("ReportAuthor")
  claims           Claim[]           @relation("Claimant")
  claimsClosed     Claim[]           @relation("ClaimClosedBy")
  messages         Message[]
  notifications    Notification[]
  flags            ModerationFlag[]
  photos           Photo[]
  auditLogs        AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserRole {
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

// ---------------------------------------------------------------------------
// Localizações e pontos de entrega
// ---------------------------------------------------------------------------

model Campus {
  id           String  @id @default(cuid())
  slug         String  @unique
  namePt       String
  nameEn       String
  city         String
  isMainCampus Boolean @default(true)
  order        Int     @default(0)

  locations      Location[]
  dropOffPoints  DropOffPoint[]
  reports        Report[]
}

model Location {
  id        String         @id @default(cuid())
  campusId  String
  parentId  String?
  /// Identificador estável do seed (ex.: "G-02", "G-05-BIB")
  code      String         @unique
  number    Int?
  namePt    String
  nameEn    String
  occupants String[]
  /// Usados na pesquisa e no matching
  aliases   String[]
  status    LocationStatus
  source    String?
  active    Boolean        @default(true)

  campus        Campus         @relation(fields: [campusId], references: [id])
  parent        Location?      @relation("LocationTree", fields: [parentId], references: [id])
  children      Location[]     @relation("LocationTree")
  dropOffPoints DropOffPoint[]
  reports       Report[]

  @@index([campusId])
}

model DropOffPoint {
  id           String  @id @default(cuid())
  campusId     String
  locationId   String?
  name         String
  directionsPt String
  directionsEn String
  /// { "mon": [["09:00","12:30"],["14:00","17:30"]], "tue": [...], ... }
  hours        Json
  hoursNote    String?
  active       Boolean @default(true)
  /// true enquanto não for confirmado pela UMinho (PROVISÓRIO)
  isPlaceholder Boolean @default(true)

  campus   Campus            @relation(fields: [campusId], references: [id])
  location Location?         @relation(fields: [locationId], references: [id])
  staff    StaffAssignment[]
  reports  Report[]
}

model StaffAssignment {
  userId         String
  dropOffPointId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dropOffPoint DropOffPoint @relation(fields: [dropOffPointId], references: [id], onDelete: Cascade)

  @@id([userId, dropOffPointId])
}

// ---------------------------------------------------------------------------
// Categorias
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  namePt      String
  nameEn      String
  allowPhotos Boolean @default(true)
  order       Int     @default(0)

  subcategories Subcategory[]
  reports       Report[]
}

model Subcategory {
  id         String @id @default(cuid())
  categoryId String
  slug       String
  namePt     String
  nameEn     String
  order      Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@unique([categoryId, slug])
}

// ---------------------------------------------------------------------------
// Anúncios
// ---------------------------------------------------------------------------

model Report {
  id            String       @id @default(cuid())
  type          ReportType
  status        ReportStatus
  authorId      String
  categoryId    String
  subcategoryId String?
  /// null = "Não sei / entre campi"
  campusId      String?
  locationId    String?
  locationNote  String?      @db.VarChar(120)
  color         Color?
  brand         String?      @db.VarChar(60)
  description   String       @db.VarChar(500)
  /// Só FOUND. Visível apenas ao autor e ao staff do ponto.
  privateDetails String?     @db.VarChar(300)

  // LOST
  lostFrom DateTime?
  lostTo   DateTime?

  // FOUND
  foundAt        DateTime?
  holderType     HolderType?
  /// Só POINT: onde foi entregue, escrito por quem encontrou. Privado (revelado só a quem reclamar).
  dropOffText    String?      @db.VarChar(120)
  /// Só POINT: preenchido quando o texto corresponde a um ponto conhecido (o staff desse ponto vê o objeto)
  dropOffPointId String?
  /// Só FINDER: contacto extra opcional (ex.: telemóvel). Privado; revelado só a quem reclamar,
  /// juntamente com o email institucional do autor.
  finderContact  String?      @db.VarChar(120)

  hiddenByModeration Boolean   @default(false)
  reminderSentAt     DateTime?
  /// Marcado quando o matching síncrono falha; a tarefa `hourly` volta a tentar
  matchPending       Boolean   @default(false)
  publishedAt        DateTime  @default(now())
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  author       User          @relation("ReportAuthor", fields: [authorId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory?  @relation(fields: [subcategoryId], references: [id])
  campus       Campus?       @relation(fields: [campusId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  dropOffPoint DropOffPoint? @relation(fields: [dropOffPointId], references: [id])

  photos             Photo[]
  claims             Claim[]
  suggestionsAsLost  MatchSuggestion[] @relation("SuggestionLost")
  suggestionsAsFound MatchSuggestion[] @relation("SuggestionFound")
  notifications      Notification[]

  @@index([status, type, categoryId, campusId])
  @@index([expiresAt])
  @@index([authorId])
  @@index([dropOffPointId, status])
}

model Photo {
  id         String   @id @default(cuid())
  /// null até o anúncio ser publicado; órfãos > 24 h são apagados pela tarefa `daily`
  reportId   String?
  uploaderId String
  fileKey    String   @unique
  thumbKey   String   @unique
  width      Int
  height     Int
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  report   Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([reportId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Reclamações e chat
// ---------------------------------------------------------------------------

/// Índice único parcial (migração SQL manual):
///   CREATE UNIQUE INDEX "Claim_one_active_per_report" ON "Claim"("reportId") WHERE status = 'ACTIVE';
model Claim {
  id          String      @id @default(cuid())
  reportId    String
  claimantId  String
  status      ClaimStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  closedAt    DateTime?
  closedById  String?
  closeReason String?

  report       Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  claimant     User          @relation("Claimant", fields: [claimantId], references: [id])
  closedBy     User?         @relation("ClaimClosedBy", fields: [closedById], references: [id])
  conversation Conversation?

  @@index([reportId, status])
  @@index([claimantId, status])
}

model Conversation {
  id      String @id @default(cuid())
  claimId String @unique

  claim    Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.VarChar(1000)
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  emailedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Matching e notificações
// ---------------------------------------------------------------------------

model MatchSuggestion {
  id            String           @id @default(cuid())
  lostReportId  String
  foundReportId String
  score         Float
  status        SuggestionStatus @default(SUGGESTED)
  notifiedAt    DateTime?
  createdAt     DateTime         @default(now())

  lostReport  Report @relation("SuggestionLost", fields: [lostReportId], references: [id], onDelete: Cascade)
  foundReport Report @relation("SuggestionFound", fields: [foundReportId], references: [id], onDelete: Cascade)

  @@unique([lostReportId, foundReportId])
  @@index([foundReportId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// Para a cascata quando o anúncio é apagado
  reportId  String?
  payload   Json
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model EmailOutbox {
  id            String    @id @default(cuid())
  to            String
  subject       String
  html          String    @db.Text
  text          String    @db.Text
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([sentAt, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Limites, moderação, auditoria, tarefas, estatísticas
// ---------------------------------------------------------------------------

/// Registo genérico para rate limits contados na BD.
/// key: "claim:<userId>", "report:<userId>", "chat:<userId>", "magic:<email-hash>".
/// Sobrevive à eliminação dos anúncios; purgado aos 30 dias pela tarefa `daily`.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ModerationFlag {
  id         String     @id @default(cuid())
  targetType FlagTarget
  targetId   String
  reporterId String
  reason     FlagReason
  comment    String?    @db.VarChar(300)
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  reporter User @relation(fields: [reporterId], references: [id])

  @@unique([targetType, targetId, reporterId])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     JobStatus
  details    Json?

  @@index([jobName, status, startedAt])
}

/// Sem identificadores pessoais nem FKs (as categorias/campi podem mudar).
model AnonymousOutcome {
  id           String       @id @default(cuid())
  type         ReportType
  categorySlug String
  campusSlug   String?
  holderType   HolderType?
  finalStatus  ReportStatus
  daysToReturn Int?
  /// "YYYY-MM"
  month        String
  createdAt    DateTime     @default(now())

  @@index([month])
}
